LOG_LEVEL=INFO

# Truncation length for long values inside a single structured log line
# (log_event does not redact secrets, only shorten long strings) — see
# docs/conventions/logging.md.
MAX_STR_LOG_LENGTH=200

API_ACCESS_KEY=

# Required for the LLM-fallback tier (Tier 1/2) and the embedding-based
# confidence cross-check. Rule-path requests never touch this. Without a
# key, OpenAIRepository short-circuits fallback calls to an api_error
# outcome and the pipeline degrades gracefully rather than failing the
# request — see docs/decisions/0001-hybrid-rule-first-llm-fallback-pipeline.md.
# Format: sk-...
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
OPENAI_ESCALATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CONFIDENCE_THRESHOLD=0.58
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000
MAX_QUERY_LENGTH=500

# Cosmetic service metadata only (FastAPI's title/version, shown in
# /docs) — not required, safe to leave at the defaults below.
PROJECT_NAME=Yad2 Search-Understanding Service
VERSION=0.1.0
